# Copy to .env for local development. Never commit .env.
PORT=3000
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Session-pooler connection string (port 5432), used only by `npm run migrate`
SUPABASE_DB_URL=your-supabase-session-pooler-connection-string-here
POSTMARK_SERVER_TOKEN=your-postmark-server-token-here
EMAIL_FROM=Focus Log <jdavis@power-in-numbers.net>
OWNER_EMAIL=jdavis@power-in-numbers.net
EMAIL_MONTHLY_CAP=90
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Generate once with: npx web-push generate-vapid-keys  (never change afterwards)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:jdavis@power-in-numbers.net
NODE_ENV=development
